POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=job_copilot
DATABASE_URL=postgresql://copilot:copilot@db:5432/job_copilot

# Groq API key for LLM-based job field extraction (free tier at console.groq.com)
# Leave empty to skip LLM and use regex/spaCy fallback only
GROQ_API_KEY=

# ── Demo mode (frontend build flag) ─────────────────────────────────────────
# Leave UNSET for normal use: a local clone talks to the real backend + database
# and persists your data. Set VITE_FORCE_DEMO=true ONLY for a public, read-only
# showcase build (this is what the Render deployment uses): every change stays in
# the visitor's browser and never touches the database. There is no password /
# login anywhere — the build flag is the only thing that changes behavior.
# VITE_FORCE_DEMO=true
